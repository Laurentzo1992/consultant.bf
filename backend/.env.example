DATABASE_URL=postgresql+psycopg2://consultantbf:consultantbf@localhost:5432/consultantbf
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_SESSION_SECRET=change-me-too-another-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PROFILE_PRICE=1000
MISSION_PRICE=2000
CONNECTION_REQUEST_PRICE=1000
CURRENCY=XOF
CORS_ORIGINS=http://localhost:5173

# "mock" for local dev (no external calls), "ligdicash" and/or "sebpay" for real
# payments -- comma-separated to offer several ("ligdicash,sebpay"), first = default
PAYMENT_PROVIDER=mock
LIGDICASH_BASE_URL=https://app.ligdicash.com
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
SEBPAY_BASE_URL=https://newapi.sebpay.bj
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=

# Must be publicly reachable URLs for the real providers
# (they call PUBLIC_BACKEND_URL/payments/ligdicash/callback and
# PUBLIC_BACKEND_URL/payments/sebpay/callback as webhooks)
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173
